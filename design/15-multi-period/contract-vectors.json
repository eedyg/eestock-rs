        "indicators": ["dcap"]
      }
    }
  },
  {
    "name": "valid-empty-indicators",
    "note": "边界：indicators 为空数组（卫星无指标 pane ⇒ 总 pane = 1）⇒ 200，归一化后仍为空。",
    "input": {
      "enabled": true,
      "periods": ["1m", "5m"],
      "heights": { "1m": 420, "5m": 180 },
      "indicators": []
    },
    "expect": {
      "status": 200,
      "normalized": {
        "enabled": true,
        "periods": ["1m", "5m"],
        "heights": { "1m": 420, "5m": 180 },
        "indicators": []
      }
    }
  },
  {
    "name": "dedup-two-identical-indicators",
    "note": "重复 indicators 去重（2 个）：02-spec §2 校验 6「去重」⇒ 归一化后 [\"dcap\"]。当前 mock 原样回显 ⇒ 预期红。",
    "input": {
      "enabled": true,
      "periods": ["1m", "5m"],
      "heights": { "1m": 420, "5m": 180 },
      "indicators": ["dcap", "dcap"]
    },
    "expect": {
      "status": 200,
      "normalized": {
        "enabled": true,
        "periods": ["1m", "5m"],
        "heights": { "1m": 420, "5m": 180 },
        "indicators": ["dcap"]
      },
      "paneCountAfterDedup": 2
    }
  },
  {
    "name": "dedup-n-identical-indicators-cannot-forge-over-12-panes",
    "note": "重复 indicators 去重（n=11）⇒ 归一化 [\"dcap\"]；**重复项无法构造 >12 pane**（去重后 1+3×1 = 4）。当前 mock 按原始长度 1+3×11 = 34 pane 误判 400 ⇒ 预期红（P1-C 误拒样本）。",
    "input": {
      "enabled": true,
      "periods": ["1m", "5m", "15m", "1h"],
      "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
      "indicators": ["dcap", "dcap", "dcap", "dcap", "dcap", "dcap", "dcap", "dcap", "dcap", "dcap", "dcap"]
    },
    "expect": {
      "status": 200,
      "normalized": {
        "enabled": true,
        "periods": ["1m", "5m", "15m", "1h"],
        "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
        "indicators": ["dcap"]
      },
      "paneCountAfterDedup": 4
    }
  },
  {
    "name": "dedup-makes-legal-repeated-indicators-over-raw-pane-budget",
    "note": "重复项导致的「去重后合法 ⇒ 200」：原始长度 1+3×5 = 16 > 12（应拒），去重后 1+3×1 = 4 ≤ 12 ⇒ 必须 200。计数必须基于去重后集合（02-spec §7.4）。当前 mock 按原始长度 ⇒ 预期红。",
    "input": {
      "enabled": true,
      "periods": ["1m", "5m", "15m", "1h"],
      "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
      "indicators": ["dcap", "dcap", "dcap", "dcap", "dcap"]
    },
    "expect": {
      "status": 200,
      "normalized": {
        "enabled": true,
        "periods": ["1m", "5m", "15m", "1h"],
        "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
        "indicators": ["dcap"]
      },
      "paneCountAfterDedup": 4
    }
  },
  {
    "name": "pane-over-limit-after-dedup-names-dimension",
    "note": "「去重后越限 ⇒ 400 且错误含维度名」：去重后 1+3×4 = 13 > 12（§7.4）。v1 受支持指标集合 = {dcap} ⇒ 未支持项规则先命中，400 的可定位维度名 = indicators（errorMustContain 断言该字段名）；pane 护栏本体由 expect.paneCountAfterDedup=13 + expect.paneGuardErrorMustContain=indicators 在纯函数层钉住（02-spec §7.4 注）。",
    "input": {
      "enabled": true,
      "periods": ["1m", "5m", "15m", "1h"],
      "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
      "indicators": ["dcap", "macd", "kdj", "boll"]
    },
    "expect": {
      "status": 400,
      "errorMustContain": "indicators",
      "paneCountAfterDedup": 13,
      "paneGuardErrorMustContain": "indicators"
    }
  },
