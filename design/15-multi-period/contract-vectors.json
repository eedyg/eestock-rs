[
  {
    "name": "valid-single-base-default",
    "note": "默认形态（02-spec §2 默认：关闭 + 单基准 1m + 高度 420 + [\"dcap\"]）⇒ 200 且归一化后逐字节等价。",
    "input": {
      "enabled": false,
      "periods": ["1m"],
      "heights": { "1m": 420 },
      "indicators": ["dcap"]
    },
    "expect": {
      "status": 200,
      "normalized": {
        "enabled": false,
        "periods": ["1m"],
        "heights": { "1m": 420 },
        "indicators": ["dcap"]
      }
    }
  },
  {
    "name": "valid-four-periods-max-legal-v1",
    "note": "v1 最大合法周形态（4 周期 × 1 指标 ⇒ 4 pane，02-spec §2 校验 4 / §7.4）⇒ 200。",
    "input": {
      "enabled": true,
      "periods": ["1m", "5m", "15m", "1h"],
      "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
      "indicators": ["dcap"]
    },
    "expect": {
      "status": 200,
      "normalized": {
        "enabled": true,
        "periods": ["1m", "5m", "15m", "1h"],
        "heights": { "1m": 420, "5m": 180, "15m": 180, "1h": 180 },
        "indicators": ["dcap"]
      }
    }
  },
  {
    "name": "valid-1w-satellite-with-1d-base",
